# Shakambhari Group (shakambharigroup.in) — Apache/GoDaddy config

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and non-www in a single hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.shakambharigroup\.in [NC]
  RewriteRule ^(.*)$ https://shakambharigroup.in/$1 [L,R=301]

  # --- Legacy WordPress URLs -> current site (301, preserves link equity) ---
  RewriteRule ^business/?$ https://shakambharigroup.in/products/ [R=301,L]
  RewriteRule ^about-us/?$ https://shakambharigroup.in/about/ [R=301,L]
  RewriteRule ^company/?$ https://shakambharigroup.in/companies/ [R=301,L]
  RewriteRule ^media/?$ https://shakambharigroup.in/csr/ [R=301,L]
  RewriteRule ^quality-sustainability/?$ https://shakambharigroup.in/sustainability/ [R=301,L]
  RewriteRule ^contact-us/?$ https://shakambharigroup.in/contact/ [R=301,L]
  RewriteRule ^corporate/?$ https://shakambharigroup.in/clientele/ [R=301,L]
  RewriteRule ^investors/?$ https://shakambharigroup.in/clientele/ [R=301,L]
  RewriteRule ^insights/?(.*)$ https://shakambharigroup.in/blogs/$1 [R=301,L]

  # --- Clean URLs for SEO canonicals ---
  # Internal rewrites only (no redirect): the old /assets/pages/*.html paths
  # keep working unchanged, since every internal <a href> on the site still
  # points to them. These just give search engines a second, cleaner path
  # that resolves to the same content, matching each page's canonical tag.
  RewriteRule ^products/?$ /assets/pages/products.html [L]
  RewriteRule ^ferro-alloys/?$ /assets/pages/ferro-alloys.html [L]
  RewriteRule ^aluminium-foil/?$ /assets/pages/aluminium-foil.html [L]
  RewriteRule ^about/?$ /assets/pages/about.html [L]
  RewriteRule ^journey/?$ /assets/pages/journey.html [L]
  RewriteRule ^companies/?$ /assets/pages/companies.html [L]
  RewriteRule ^csr/?$ /assets/pages/csr.html [L]
  RewriteRule ^sustainability/?$ /assets/pages/sustainability.html [L]
  RewriteRule ^contact/?$ /assets/pages/contact.html [L]
  RewriteRule ^vision/?$ /assets/pages/vision.html [L]
  RewriteRule ^leadership/?$ /assets/pages/leadership.html [L]
  RewriteRule ^quality/?$ /assets/pages/quality.html [L]
  RewriteRule ^process/?$ /assets/pages/process.html [L]
  RewriteRule ^careers/?$ /assets/pages/careers.html [L]
  RewriteRule ^clientele/?$ /assets/pages/clientele.html [L]
  RewriteRule ^awards/?$ /assets/pages/awards.html [L]
  RewriteRule ^gallery/?$ /assets/pages/gallery.html [L]

  RewriteRule ^blogs/?$ /assets/pages/blogs.html [L]
  RewriteRule ^blogs/tempcore-tmt-bars/?$ /assets/pages/blog-tempcore-tmt-bars.html [L]
  RewriteRule ^blogs/sponge-iron-india/?$ /assets/pages/blog-sponge-iron-india.html [L]
  RewriteRule ^blogs/silicomanganese/?$ /assets/pages/blog-silicomanganese.html [L]
  RewriteRule ^blogs/steel-policy-2030/?$ /assets/pages/blog-steel-policy-2030.html [L]
  RewriteRule ^blogs/green-steel-taxonomy/?$ /assets/pages/blog-green-steel-taxonomy.html [L]
  RewriteRule ^blogs/aluminium-foil-pharma/?$ /assets/pages/blog-aluminium-foil-pharma.html [L]

  RewriteRule ^steel/?$ /assets/pages/steel/ [L]
  RewriteRule ^steel/concrete-reinforcement/?$ /assets/pages/steel/concrete-reinforcement/ [L]
  RewriteRule ^steel/heavy-structural/?$ /assets/pages/steel/heavy-structural/ [L]
  RewriteRule ^steel/espl-tubes/?$ /assets/pages/steel/espl-tubes/ [L]
  RewriteRule ^steel/precision-strips/?$ /assets/pages/steel/precision-strips/ [L]
  RewriteRule ^steel/wire-rods-and-wires/?$ /assets/pages/steel/wire-rods-and-wires/ [L]
  RewriteRule ^steel/fasteners/?$ /assets/pages/steel/fasteners/ [L]
  RewriteRule ^steel/upstream-intermediate/?$ /assets/pages/steel/upstream-intermediate/ [L]
</IfModule>

# GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Static asset caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|mp4|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
